# GEMINI_API_KEY: Optional - Required only if server-side Gemini AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_*: Client-side environment variables in Vite must start with 'VITE_'.
# In client-side code, access these using 'import.meta.env.VITE_*' (NOT process.env.*).
# Example for Vercel:
VITE_APP_URL="https://your-app.vercel.app"
